{
  "global": {
    "ctrl-b": "app.prefix"
  },
  "prefix": {
    "c": "tab.new",
    "shift-c": "space.new",
    "n": "tab.next",
    "p": "tab.prev",
    "shift-n": "space.next",
    "shift-p": "space.prev",
    "1": "tab.select:1",
    "2": "tab.select:2",
    "3": "tab.select:3",
    "4": "tab.select:4",
    "5": "tab.select:5",
    "6": "tab.select:6",
    "7": "tab.select:7",
    "8": "tab.select:8",
    "9": "tab.select:9",
    "h": "pane.go:left",
    "j": "pane.go:down",
    "k": "pane.go:up",
    "l": "pane.go:right",
    "shift-h": "pane.swap:left",
    "shift-j": "pane.swap:down",
    "shift-k": "pane.swap:up",
    "shift-l": "pane.swap:right",
    "v": "pane.split:right",
    "s": "pane.split:down",
    "x": "pane.close",
    "z": "pane.zoom",
    "w": "tab.close",
    ",": "tab.rename",
    "b": "layout.toggle:sidebar",
    "g": "layout.toggle:changes",
    "space": "app.palette",
    "shift-/": "app.help",
    "left": "pane.go:left",
    "down": "pane.go:down",
    "up": "pane.go:up",
    "right": "pane.go:right",
    "a": "agent.next",
    "shift-a": "agent.prev",
    "o": "app.settings",
    "t": "mod.open:picker",
    "m": "layout.switch",
    "shift-w": "space.close",
    "shift-r": "space.rename",
    "=": "app.zoom_in",
    "-": "app.zoom_out",
    "0": "app.zoom_reset"
  },
  "terminal": {
    "ctrl-backspace": "send:\u0017",
    "ctrl-left": "send:\u001bb",
    "ctrl-right": "send:\u001bf",
    "ctrl-shift-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "ctrl-v": "terminal.paste_image",
    "ctrl-insert": "terminal.copy",
    "shift-insert": "terminal.paste"
  }
}
